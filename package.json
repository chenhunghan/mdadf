{
  "name": "mdadf",
  "version": "0.1.4",
  "description": "Convert Markdown to Atlassian Document Format (ADF)",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "mdadf": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --compile --outfile mdadf",
    "lint": "oxlint src/",
    "fmt": "oxfmt --write src/",
    "check": "oxlint src/ && oxfmt --check src/ && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "ajv": "^8.18.0",
    "ajv-draft-04": "^1.0.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@atlaskit/adf-schema": "^52.4.15",
    "@atlaskit/editor-json-transformer": "^8.31.8",
    "@atlaskit/editor-markdown-transformer": "^5.20.6"
  }
}
